
let arr = [1, 2, 3, 4, 5];
//Add items to the end of the array with .push()
arr.push(6);
console.log(arr); // [1, 2, 3, 4, 5, 6]

//Remove items from the end of the array with .pop()
let arr2 = [7, 8, 9];
arr2.pop();
console.log(arr2); // [7, 8]

//Add to the beginning of the array with .unshift() 
let arr3 = [10, 11, 12];
arr3.unshift(9);
console.log(arr3); // [9, 10, 11, 12]   

//Remove from the beginning of the array with .shift()
let arr4 = [13, 14, 15];
arr4.shift();
console.log(arr4); // [14, 15]

//spice() can add or remove items from anywhere in the array
let arr5 = [16, 17, 18, 19, 20];
//remove 2 items starting from index 1
arr5.splice(1, 2);// [16, 19, 20]
console.log(arr5); // [16, 19, 20]

arr.shift();      // [1, 2, 3, 5, 6]
// splice(start, deleteCount, ...itemsToAdd)
arr.splice(2, 1);        // removes 1 item at index 2
arr.splice(2, 0, 99);    // inserts 99 at index 2, removes nothing
arr.splice(1, 2, 10, 20); // removes 2 items from index 1, inserts 10 and 20


